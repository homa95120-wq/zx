{
  "name": "zx-agent",
  "version": "1.5.0",
  "description": "zx — ИИ-агент для кода: терминал и файлы, бесплатные модели + топовые Claude/GPT по ключу, сборка в один .exe",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/run-tests.js && node test/browser-smoke.js",
    "build:exe": "pkg . --output release/zx-agent.exe",
    "build:all": "pkg . --output release/zx-agent"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "release"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "jsdom": "^30.1.3"
  }
}
